package routines;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.InputStreamReader;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.List;

import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.streaming.SXSSFWorkbook;

public class CSVToExcelConverter {

    public static void csvtoexcel(String folderName, String outputFile) throws IOException {

        File folder = new File(folderName);
        File[] csvFiles = folder.listFiles((dir, name) -> name.toLowerCase().endsWith(".csv"));

        if (csvFiles == null || csvFiles.length == 0) {
            System.out.println("No CSV files found.");
            return;
        }

        // Streaming workbook (memory safe)
        SXSSFWorkbook workbook = new SXSSFWorkbook(100);
        workbook.setCompressTempFiles(true);

        for (File csvFile : csvFiles) {
            System.out.println("Processing: " + csvFile.getName());

            String sheetName = sanitizeSheetName(csvFile.getName());
            Sheet sheet = workbook.createSheet(sheetName);

            writeCsvToSheet(csvFile, sheet);
        }

        try (FileOutputStream fos = new FileOutputStream(outputFile)) {
            workbook.write(fos);
        }

        workbook.dispose();
        System.out.println("Excel file generated successfully.");
    }

    // ---------------------------------
    // Read CSV and write to Excel sheet
    // ---------------------------------
    private static void writeCsvToSheet(File csvFile, Sheet sheet) throws IOException {

        try (BufferedReader reader = new BufferedReader(
                new InputStreamReader(new FileInputStream(csvFile), StandardCharsets.UTF_8))) {

            String line;
            int rowNum = 0;

            while ((line = reader.readLine()) != null) {
                Row row = sheet.createRow(rowNum++);
                List<String> columns = parseCsvLine(line);

                for (int col = 0; col < columns.size(); col++) {
                    Cell cell = row.createCell(col);
                    setCellValue(cell, columns.get(col));
                }
            }
        }
    }

    // ---------------------------------
    // CSV parser (handles quoted commas)
    // ---------------------------------
    private static List<String> parseCsvLine(String line) {

        List<String> values = new ArrayList<>();
        String[] tokens = line.split(",(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)", -1);

        for (String token : tokens) {
            values.add(token.replace("\"", "").trim());
        }
        return values;
    }

    // ---------------------------------
    // Set cell value with type detection
    // ---------------------------------
    private static void setCellValue(Cell cell, String value) {

        if (value == null || value.isEmpty()) {
            cell.setCellType(CellType.BLANK);
            return;
        }

        // Numeric (handles negative & decimals)
        if (value.matches("-?\\d+(\\.\\d+)?")) {
            cell.setCellType(CellType.NUMERIC);
            cell.setCellValue(Double.parseDouble(value));
            return;
        }

        // Protect against Excel formula injection
        if (value.startsWith("=") || value.startsWith("+")
                || value.startsWith("-") || value.startsWith("@")) {
            cell.setCellType(CellType.STRING);
            cell.setCellValue("'" + value);
            return;
        }

        cell.setCellType(CellType.STRING);
        cell.setCellValue(value);
    }

    // ---------------------------------
    // Excel-safe sheet name (no .csv)
    // ---------------------------------
    private static String sanitizeSheetName(String name) {

        // Remove .csv extension
        String clean = name.replaceAll("(?i)\\.csv$", "");

        // Remove illegal Excel characters
        clean = clean.replaceAll("[\\\\/*?:\\[\\]]", "_");

        // Excel sheet name max length = 31
        return clean.length() > 31 ? clean.substring(0, 31) : clean;
    }
}
